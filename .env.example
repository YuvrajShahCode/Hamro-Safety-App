# Backend API base URL. MUST be set for real emergency data to reach your server.
# NOTE: must be prefixed with EXPO_PUBLIC_ so Expo inlines it into the JS bundle
# at build time (see https://docs.expo.dev/guides/environment-variables/).
# Anything without this prefix is server-only and invisible to client code -
# do not put secrets (API keys, SMS credentials) behind this prefix.
EXPO_PUBLIC_API_BASE_URL=https://api.hamrosafety.example.com

# Firebase Cloud Messaging (push notifications) - required for real push delivery.
# These stay server-side / native-config only, never EXPO_PUBLIC_-prefixed.
FCM_SENDER_ID=
FCM_API_KEY=

# SMS provider (e.g. Twilio) - required for SMS-based emergency alerts to contacts.
# Used by your BACKEND, never bundled into the client app.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_FROM_NUMBER=

# Environment: development | staging | production
APP_ENV=development
